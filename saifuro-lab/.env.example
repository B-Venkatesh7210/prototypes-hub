# Wallets: `npm run wallets` writes BUYER_PRIVATE_KEY, SELLER_PRIVATE_KEY and SELLER_ADDRESS
# to .env.local (testnet only). Payments switch to live Base Sepolia settlement on their own
# once the buyer holds 0.01 test USDC from https://faucet.circle.com.
BUYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
SELLER_ADDRESS=
# live | simulated. Unset: live when the buyer is funded.
X402_MODE=
X402_FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Agent model, any OpenAI-compatible endpoint. Groq's free tier works.
# Without a key, the scripted scenarios still run; only free-form chat is off.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Real Saifuro instead of the local emulator (keys are issued at onboarding).
# SAIFURO_API_URL=https://api.saifuro.com
# SAIFURO_API_KEY=sk_sandbox_...

# Only if the app is not on http://localhost:3003
# APP_URL=
