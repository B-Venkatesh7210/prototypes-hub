# Optional: AI for partner analysis. Any OpenAI-compatible endpoint works.
# Free: create a key at https://aistudio.google.com/apikey (Gemini). Without a key the studio uses templates.
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_ANALYSES_PER_DAY=20

# Optional: Base RPC for live market data. The public endpoint works; a free Alchemy URL is steadier.
# BASE_RPC_URL=https://mainnet.base.org

# Optional: real transactions in the preview. Point at a fork of Base:
#   local:    npm run fork   (Anvil, see README) then FORK_RPC_URL=http://127.0.0.1:8545
#   hosted:   a Tenderly Virtual TestNet RPC forked from Base
# Without it, the preview simulates deposits on live Aave rates.
FORK_RPC_URL=

# Optional: keeps sandbox wallets stable across server restarts.
# SANDBOX_SECRET=
