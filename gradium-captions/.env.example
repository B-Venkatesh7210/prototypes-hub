# Server-only. Never expose this to the browser or commit it.
GRADIUM_API_KEY=gd_your_api_key_here

# "mock" (default) never calls Gradium and spends zero credits.
# "live" calls the real API. Both a key and GRADIUM_MODE=live are required.
GRADIUM_MODE=mock

# Optional: pin sessions to a region. One of api, eu.api, us.api
GRADIUM_HOST=api
