# "mock" (default) never calls Gradium and spends zero credits.
# "live" calls the real API with each visitor's own key, added in the app's "Add API key" dialog.
GRADIUM_MODE=mock

# Optional: pin sessions to a region. One of api, eu.api, us.api
GRADIUM_HOST=api

# Optional, server-only. Used only by `npm run previews`, never for visitors' requests.
# GRADIUM_API_KEY=gd_your_api_key_here
